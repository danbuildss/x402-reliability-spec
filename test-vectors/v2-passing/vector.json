{
  "description": "x402 V2 service: terms only in the base64 PAYMENT-REQUIRED header (empty body), payment in PAYMENT-SIGNATURE, receipt in PAYMENT-RESPONSE. Everything passes.",
  "checker": {
    "max_price_usdc": 0.1,
    "schema": {
      "type": "object",
      "required": [
        "price"
      ],
      "properties": {
        "price": {
          "type": "number"
        }
      }
    },
    "wallet_balance_usdc": 1000
  },
  "unpaid": {
    "status": 402,
    "headers": {
      "content-type": "application/json",
      "payment-required": {
        "x402Version": 2,
        "resource": {
          "url": "{{ENDPOINT}}",
          "description": "Test price quote",
          "mimeType": "application/json"
        },
        "accepts": [
          {
            "scheme": "exact",
            "network": "eip155:8453",
            "amount": "1000",
            "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
            "payTo": "0x209693Bc6afc0C5328bA36FaF03C514EF312287C",
            "maxTimeoutSeconds": 60,
            "extra": {
              "name": "USD Coin",
              "version": "2"
            }
          }
        ]
      }
    },
    "body": ""
  },
  "paid": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "payment-response": {
        "success": true,
        "transaction": "0xcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
        "network": "eip155:8453",
        "payer": "{{CHECKER_WALLET}}"
      }
    },
    "body": {
      "price": 123.45
    }
  }
}
